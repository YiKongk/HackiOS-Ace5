# Source whitelist: downloads, caches, Apple files, firmware and logs stay local.
# The public snapshot contains both kernel and userland source in one Git tree.
/*
!/.gitignore
!/README.md
!/LICENSE
!/common/
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/xnu/
!/xnu-deps/
!/uefi/
!/wifi/

__pycache__/
*~
*.orig
*.rej


/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/identity.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize

!/AGENTS.md
!/RELEASE.json
!/NOTICE.md
!/LICENSES/
!/userland/
!/ios165/
!/scripts/

/userland/*
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.redwood.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/
/ios165/*
!/ios165/fetch.sh
!/ios165/*.py

.DS_Store
*.pyc
*.pyo
*.o
*.obj
*.dSYM/
*.log
*.tmp
*.bak
*.apfs
*.ipsw
*.dmg
*.img
*.dtb
*.efi
*.te
*.mbn
*.fw
*.bin
*.dylib
/out/
/local/
/logs/
/fw-*/
/prebuilt/
/.userland.git/
/xnu-src/
/uefi/files/Binaries/
/xnu/files/bsd/dev/redwood_focaltech_fw.h
# Test/source fixtures are text; do not force-add generated binaries.

# This is a text command recipe, not an APFS image.
!/userland/rc.jobs.apfs
